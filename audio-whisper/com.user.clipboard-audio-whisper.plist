<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Auto-starts clipboard-audio-whisper.sh at login and keeps it running.

  Easiest install: run ./install.sh audio from the repo root.

  Manual install:
    1. Replace YOUR_USERNAME below with your username (script lives in ~/scripts/).
    2. cp com.user.clipboard-audio-whisper.plist ~/Library/LaunchAgents/
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.user.clipboard-audio-whisper.plist

  Uninstall:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.user.clipboard-audio-whisper.plist
    rm ~/Library/LaunchAgents/com.user.clipboard-audio-whisper.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.clipboard-audio-whisper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOUR_USERNAME/scripts/clipboard-audio-whisper.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/clipboard-audio-whisper.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/clipboard-audio-whisper.err</string>
</dict>
</plist>
